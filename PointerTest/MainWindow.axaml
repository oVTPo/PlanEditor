<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="PointerTest.MainWindow"
    Width="700"
    Height="400"
    Title="PointerTest">

    <Grid
        Background="White"
        PointerPressed="OnPointerPressed">

        <StackPanel
            Width="300"
            Spacing="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                x:Name="StatusText"
                Text="Chưa nhận pointer"
                FontSize="20"
                HorizontalAlignment="Center"/>

            <Button
                Content="CLICK TEST"
                Height="60"
                Click="OnButtonClick"/>
        </StackPanel>

    </Grid>
</Window>